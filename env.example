# NEOM//NET environment variables.
# In development every value below has a built-in default matching docker-compose.yml,
# so you can run without any .env file. For anything beyond local play, create
# apps/server/.env (git-ignored) and set real values. Never commit secrets.

# Local docker-compose Postgres (dev-only throwaway credentials, port 5433 on the host)
DATABASE_URL="postgresql://neom:neom_dev_password@localhost:5433/neom_net?schema=public"

# Session token signing secret. Generate: openssl rand -hex 32
# The server refuses to start in production without one.
JWT_SECRET=""

# Days an idle device stays signed in. Sessions slide: any request after a day renews the cookie.
SESSION_DAYS=30

# API + WebSocket port
PORT=4000

# Allowed browser origins, comma-separated (the Vite dev server proxies /api, so these only matter for cross-origin setups)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# development | production | test
NODE_ENV=development

# Web Push (optional). Generate once with: npx web-push generate-vapid-keys
# Without these, push notifications are disabled (dev generates a throwaway pair in the OS temp dir).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
